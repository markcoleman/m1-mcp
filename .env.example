# Copy to .env and fill in values. Do NOT commit real secrets.

# Use Members1st endpoints (instead of mock data)
DATA_SOURCE=members1st

# Members1st endpoints (optional overrides)
# MEMBERS1ST_ACCOUNTS_URL=https://myonline.members1st.org/api/v1/account
# MEMBERS1ST_TRANSACTIONS_URL_BASE=https://myonline.members1st.org/api/v1/Transactions
# MEMBERS1ST_ORIGIN=https://myonline.members1st.org

# Auth/session (provide via env only)
# Option 1: Set cookie value directly
# MEMBERS1ST_COOKIE=
# Option 2: Read cookie from a file (more convenient for long values)
# MEMBERS1ST_COOKIE_FILE=.members1st-cookie
# Authorization token (if needed)
# MEMBERS1ST_AUTHORIZATION=

# Extra required headers (often includes NCSRF). Must be valid JSON.
# MEMBERS1ST_HEADERS_JSON={"NCSRF":"...","X-Akamai-Client-Type":"Web"}

# Cache
# MEMBERS1ST_CACHE_TTL_MS=30000

# API Request Logging (disabled in production mode)
# LOG_API_REQUESTS=true
# LOG_API_RESPONSES=false
# NODE_ENV=development
