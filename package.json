{
  "name": "m1-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example MCP server exposing account tools",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:http": "MCP_TRANSPORT=http node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/server.ts",
    "get:account": "tsx src/run-get-account.ts",
    "test:members1st-cookie": "tsx src/test-members1st-cookie.ts",
    "test:cookie-file": "tsx src/test-cookie-file.ts",
    "test:members1st-transactions": "tsx src/test-members1st-transactions.ts",
    "test:unit": "DATA_SOURCE=mock node --test --experimental-test-coverage dist/**/*.test.js",
    "test:unit:dev": "DATA_SOURCE=mock tsx --test src/**/*.test.ts",
    "test:integration": "node dist/test-harness.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
